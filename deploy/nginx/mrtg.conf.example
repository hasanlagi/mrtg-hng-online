server {
    listen 80;
    server_name mrtg.example.com;
    root /var/www/mrtg;
    index index.php;

    location / { try_files $uri $uri/ =404; }
    location ~ /\. { return 404; }
    location ~ ^/(bin|config|deploy|runtime|sql|src|tests)(/|$) { return 404; }
    location = /README.md { return 404; }
    location ~ ^/[a-z0-9-]+(?:_[a-z0-9-]+)*\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~* \.php(/|$) { return 404; }
}
